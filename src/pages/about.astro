---
import Layout from '../layouts/Layout.astro';

import TempProfilePic from '../assets/TempProfilePic.png';
import HTML_Pic from '../assets/html.png';
import CSS_Pic from '../assets/css_blue.png';
import Liquid_Pic from '../assets/liquid.png';
import SQL_Pic from '../assets/sql.png';
import Git_Pic from '../assets/git.png';
import Js_Pic from '../assets/js.png';
import UE_Pic from '../assets/Unreal engine Logo.png';
import Cpp_Pic from '../assets/c++.png';
import Rust_Pic from '../assets/rust.png';
import RTF_Pic from '../assets/rtf.png';

import { Mail, Calendar, MapPinHouse, Folder,  ArrowRight, CodeXml, Lightbulb, Rocket, Gamepad2, Trophy, User, ShoppingBag, Cpu } from "lucide-astro";
---

<Layout>
   <div style=" padding:40px; justify-content: space-between; background-color: #01040d; display: flex; gap: 40px;">
        <div>
            <h1 style="color:#8B5CF6; font-size: 25px; margin:0px;">About Me</h1>
            <h2 style="color: #fff; margin:0px; font-size:50px;">Hi, I'm Jordan</h2>
            <h2 style="color: #8B5CF6; margin-top:10px;">Developer. Problem Solver. Builder</h2>
            <h3 style="color: #fff; margin-top:20px; font-size: 15px; max-width: 350px;">I'm a developer with a passion for building clean, and user focused solutions. I enjoy turning ideas into real products that make an impact.</h3>
            <div style="display:flex; gap:30px; margin-top:20px;">
                <div style="display:flex;">
                    <MapPinHouse style="color:#8B5CF6; margin-right: 10px;" />
                    <div style="display:flex; flex-direction: column;">
                        <span style=" color: #fff; font-size: 14px;">Location </span>
                        <span style="color: #fff; font-size: 14px; margin-top:5px;">Pennsylvania, USA</span>
                    </div>
                </div>
                <div style="display:flex;">
                    <Calendar style="color:#8B5CF6; margin-right: 10px;" />
                    <div style="display:flex; flex-direction: column;">
                        <span style="color: #fff; font-size: 14px;">Experience </span>
                        <span style="color: #fff; font-size: 14px; margin-top:5px;">3+ years</span>
                    </div>
                </div>
                <div style="display:flex;">
                    <Mail style="color:#8B5CF6; margin-right: 10px;" />
                    <div style="display:flex; flex-direction: column;">
                        <span style="color: #fff; font-size: 14px;" >Email </span>
                        <span style="color: #fff; font-size: 14px; margin-top:5px;">j0rdnk1ng2000@gmail.com</span>
                    </div>
                </div>
            </div>
            <div style="padding:15px 0px; margin-top: 20px;">
                <a href="mailto:j0rdnk1ng2000@gmail.com" style="display:flex; width:fit-content; padding:20px; background-color: #8B5CF6; color: white; text-decoration: none; border-radius: 5px;" href="mailto:j0rdnk1ng2000@gmail.com">Lets Connect <ArrowRight style="margin-left:10px;" color="white" size={18} /></a>
            </div>
        </div>

        <div>
            <img src={TempProfilePic.src} width="100%" height="350px" alt="Temp Profile Pic" />
        </div>
   </div>

   <div style="padding: 40px; display: flex; justify-content: space-between; background-color: #01040d;">
        <div>
            <h1 style="margin:0px; font-size:14px; color: #8B5CF6;">MY STORY</h1>
            <h2 style="margin-top:10px;  color: #fff;"> A little about me. </h2>
            <p style="max-width:400px; line-height: 13px; margin-top:20px; font-size: 12px; color: #fff;"> I've always been curious about how things work. That curiosity led me to coding, where I found the perfect mix of creativity and logic. Over the years , I've worked on a variety of projects-- from web applications to embedded systems and game development.</p>
            <p style="max-width:400px; line-height: 13px; margin:0px; font-size: 12px; color: #fff;"> When I'm not coding, you can find me exploring new technologies, hiking, or working on personal projects.</p>
            <div style="margin-top:20px;">
                <div style="display:flex;">
                    <div style="background-color: #0A101B; padding:10px; margin-right: 15px; border-radius: 6px;">
                        <CodeXml color="#8B5CF6" size={30} />
                    </div>
                    <div style="line-height: 20px; display: flex; flex-direction: column;">
                        <span style="font-size: 16px; color: #fff;">Focuse on writting clean, maintainable code.</span>
                        <span style=" font-size: 12px; color: #fff;">I follow best practices and enjoy solving complex problems.</span>
                    </div>
                </div>

                <div style="margin-top: 15px; display:flex;">
                    <div style="background-color: #0A101B; padding:10px; margin-right: 15px; border-radius: 6px;">
                        <Lightbulb color="#8B5CF6" size={30} />
                    </div>
                    <div style="line-height: 20px; display: flex; flex-direction: column;">
                        <span style="font-size: 16px; color: #fff;">Continous Learner.</span>
                        <span style=" font-size: 12px; color: #fff;">I'm always exploring new tools, frameworks, and technologies.</span>
                    </div>
                </div>

                <div style="margin-top: 15px; display:flex;">
                    <div style="background-color: #0A101B; padding:10px; margin-right: 15px; border-radius: 6px;">
                        <Rocket color="#8B5CF6" size={30} />
                    </div>
                    <div style="line-height: 20px; display: flex; flex-direction: column;">
                        <span style="font-size: 16px; color: #fff;">Builder at heart.</span>
                        <span style=" font-size: 12px; color: #fff;">I love taking ideas from concepts to a fully functional product.</span>
                    </div>
                </div>

            </div>
        </div>
        <div style="padding:20px; max-width:400px; background-color: #0A101B; border-radius: 6px; display:flex; flex-direction: column;">
            <h2 style="margin-bottom: 20px; margin-top: 0px; color: #fff;"> What I Do </h2>
            <div>
                <div style="display:flex;">
                    <div style="padding:10px 20px; border-radius: 6px; background-color: #01040d; margin-right: 10px;">
                        <CodeXml color="#8B5CF6" size={40} />
                    </div>
                    <div style="display:flex; flex-direction: column; line-height: 20px;">
                        <span style="font-size: 16px; color: #fff;">Web Development</span>
                        <span style="font-size: 14px; color: #ccc;">Building responsive, accessible, and performant web applications with modern technologies.</span>
                    </div>    
                </div>

                <div style="display:flex; margin-top: 15px;">
                     <div style="padding:10px 20px; border-radius: 6px; background-color: #01040d; margin-right: 10px;">
                        <ShoppingBag color="#10B981" size={40} />
                     </div>
                    
                    <div style="display:flex; flex-direction: column; line-height: 20px;">
                        <span style="font-size: 16px; color: #fff;">E-Commerce Solutions</span>
                        <span style="font-size: 14px; color: #ccc;">Creating custom e-commerce experinces that drive results and improve conversions.</span>
                    </div>    
                </div>

                <div style="display:flex; margin-top: 15px;">
                     <div style="padding:10px 20px; border-radius: 6px; background-color: #01040d; margin-right: 10px;">
                        <Gamepad2 color="#3B82F6" size={40} />
                    </div>
                    
                    
                    <div style="display:flex; flex-direction: column; line-height: 20px;">
                        <span style="font-size: 16px; color: #fff;">Game Development</span>
                        <span style="font-size: 14px; color: #ccc;">Designing and developing immersive gameplay experince in Unreal Engine.</span>
                    </div>    
                </div>

                <div style="display:flex; margin-top: 15px;">
                    <div style="padding:10px 20px; border-radius: 6px; background-color: #01040d; margin-right: 10px;">
                        <Cpu color="#F97316" size={40} />
                    </div>
                    
                    
                    <div style="display:flex; flex-direction: column; line-height: 20px;">
                        <span style="font-size: 16px; color: #fff;">Embedded Systems</span>
                        <span style="font-size: 14px; color: #ccc;">Working with microcontrollers and sensors to build reliable, efficient embedded solutions.</span>
                    </div>    
                </div>
            </div>
        </div>

        
   </div>
   <div style=" padding:20px 40px; background-color: #01040d;">
        <div style="border-radius:6px; padding:20px; background-color: #0A101B;">
            <span style="color:#8B5CF6;">TECHNOLOGIES I WORK WITH</span>
            <div style="gap:40px; display:flex; flex-direction: row; padding:20px 10px;">
                
                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div>
                         <img src={HTML_Pic.src} width="50px" height="50px" alt="Temp Profile Pic" />
                    </div>
                    <span style="margin-top:10px; color: #fff;"> HTML </span>
                </div>

                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div>
                         <img src={CSS_Pic.src} width="50px" height="50px" alt="Temp Profile Pic" />
                    </div>
                    <span style="margin-top:10px; color: #fff;"> CSS </span>
                </div>

                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div style="background-color: white;">
                         <img src={Liquid_Pic.src} width="50px" height="50px" alt="Temp Profile Pic" />
                    </div>
                    <span style="margin-top:10px; color: #fff;"> Liquid </span>
                </div>

                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div>
                         <img src={Js_Pic.src} width="50px" height="50px" alt="Temp Profile Pic" />
                    </div>
                    <span style="margin-top:10px; color: #fff;"> JavaScript </span>
                </div>

                 <div style="display: flex; flex-direction: column; align-items: center;">
                    <div style="">
                         <img src={SQL_Pic.src} width="50px" height="50px" alt="Temp Profile Pic" />
                    </div>
                    <span style="margin-top:10px; color: #fff;"> SQL </span>
                </div>

                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div>
                         <img src={Git_Pic.src} width="50px" height="50px" alt="Temp Profile Pic" />
                    </div>
                    <span style=" margin-top:10px; color: #fff;"> Git </span>
                </div>

                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div>
                         <img src={UE_Pic.src} width="50px" height="50px" alt="Temp Profile Pic" />
                    </div>
                    <span style=" margin-top:10px; color: #fff;"> Unreal Engine </span>
                </div>

                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div>
                         <img src={Cpp_Pic.src} width="50px" height="50px" alt="Temp Profile Pic" />
                    </div>
                    <span style=" margin-top:10px; color: #fff;"> C++ </span>
                </div>

                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div>
                         <img src={Rust_Pic.src} width="50px" height="50px" alt="Temp Profile Pic" />
                    </div>
                    <span style=" margin-top:10px; color: #fff;"> Rust </span>
                </div>

                <div style="display: flex; flex-direction: column; align-items: center;">
                    <div>
                         <img src={RTF_Pic.src} width="50px" height="50px" alt="Temp Profile Pic" />
                    </div>
                    <span style=" margin-top:10px; color: #fff;"> RTF </span>
                </div>
                
            </div>  
        </div>
    </div>  
   
   <div style="padding:20px 40px; background-color: #01040d;">
        <div style="gap:30px; justify-content: space-between; display:flex; border-radius:6px; padding:20px; background-color: #0A101B;">
            
            <div style="display:flex;">
                <Folder style="color:#8B5CF6; margin-right: 10px;" size={40} />
                <div style="display:flex; flex-direction: column;">
                    <span style="font-size: 24px; color:white;">20+</span>
                    <span style="color:white;">Projects Completed</span>
                </div>
            </div>
            
            <div style="display:flex;">
                <User style="color:#8B5CF6; margin-right: 10px;" size={40} />
                <div style="display:flex; flex-direction: column;">
                    <span style="font-size: 24px; color:white;">3+</span>
                    <span style="color:white;">Years of Experience</span>
                </div>
            </div>

            <div style="display:flex;">
                <CodeXml style="color:#8B5CF6; margin-right: 10px;" size={40} />
                <div style="display:flex; flex-direction: column;">
                    <span style="font-size: 24px; color:white;">10+</span>
                    <span style="color:white;">Technologies</span>
                </div>
            </div>

            <div style="display:flex;">
                <Trophy style="color:#8B5CF6; margin-right: 10px;" size={40} />
                <div style="display:flex; flex-direction: column;">
                    <span style="font-size: 24px; color:white;">100%</span>
                    <span style="color:white;">Passion</span>
                </div>
            </div>
        </div>
   </div>
   
   <div style="padding:10px 40px; background-color: #01040d;">
        <div style="justify-content: space-between; display:flex; border-radius: 6px; padding:20px; background-color: #0A101B;">
            <div style="display:flex; ">
                <Rocket color="#8B5CF6" size={40} />
                <div style="margin-left: 20px; display:flex; flex-direction: column;">
                    <span style="font-size: 18px; margin-bottom: 10px; color:white;">Let's build something amazing together.</span>
                    <span style="font-size: 14px; color:white;">I'm always open to new opportunities and interesting projects.</span>
                </div>
            </div>
           
            <a href="http://localhost:4321/projects" style="text-decoration: none; display:flex; align-items: center; background:#8B5CF6; color:white; padding:10px; border-radius:6px; text-decoration:none;`">Get In Touch<ArrowRight style="margin-left:10px;" color="white" size={20} /></a>
        </div>
   </div>
</Layout>