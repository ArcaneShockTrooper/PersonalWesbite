<script>
    const row = document.getElementById('infoRow');
    const dots = document.querySelectorAll('#infoDots .dot');
    const items = row ? Array.from(row.children) : [];
    const rightButton = document.querySelector('#infoDots .info-button.right');
    const leftButton = document.querySelector('#infoDots .info-button.left');

    const scrollAmount = 300;
    const tolerance = 5; // px buffer to avoid rounding issues|

    updateInfoButtons();

    rightButton?.addEventListener("click", () => {
        row?.scrollBy({
            left: scrollAmount,
            behavior: "smooth"
        });
    });

    leftButton?.addEventListener("click", () => {
        
        row?.scrollBy({
            left: -scrollAmount,
            behavior: "smooth"
        });
    });

    function updateInfoButtons(){
         if (!row || !leftButton || !rightButton) return;
        const { scrollLeft, scrollWidth, clientWidth } = row;

        const atStart = scrollLeft <= tolerance;
        const atEnd = scrollLeft + clientWidth >= scrollWidth - tolerance;
        console.log("ScrollLeft: " + scrollLeft + ", tolerance: " + tolerance + ", atStart: " + atStart + ", atEnd: " + atEnd);
        leftButton.classList.toggle('is-hidden', atStart);
        rightButton.classList.toggle('is-hidden', atEnd);

    }

    if (row) {
        // --- active dot tracking on scroll ---
        let ticking = false;
        const updateActiveDot = () => {
            const rowLeft = row.getBoundingClientRect().left;
            let closestIndex = 0;
            let closestDist = Infinity;
            items.forEach((item, i) => {
                const dist = Math.abs(item.getBoundingClientRect().left - rowLeft);
                if (dist < closestDist) {
                    closestDist = dist;
                    closestIndex = i;
                }
            });
            dots.forEach((dot, i) => dot.classList.toggle('active', i === closestIndex));
        };

        // --- drag to scroll ---
        let isDown = false;
        let didDrag = false;
        let startX = 0;
        let startScrollLeft = 0;

        const startDrag = (clientX) => {
            isDown = true;
            didDrag = false;
            startX = clientX;
            startScrollLeft = row.scrollLeft;
            row.classList.add('dragging');
        };

        const moveDrag = (clientX) => {
            if (!isDown) return;
            const delta = clientX - startX;
            if (Math.abs(delta) > 3) didDrag = true;
            row.scrollLeft = startScrollLeft - delta;
        };

        const endDrag = () => {
            if (!isDown) return;
            isDown = false;
            row.classList.remove('dragging');
            updateActiveDot();
        };

        row.addEventListener('pointerdown', (e) => {
            row.setPointerCapture(e.pointerId);
            startDrag(e.clientX);
        });

        row.addEventListener('pointermove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            moveDrag(e.clientX);
        });

        row.addEventListener('pointerup', endDrag);
        row.addEventListener('pointercancel', endDrag);
        row.addEventListener('pointerleave', endDrag);

        // stop a drag from also firing a click on whatever's underneath
        row.addEventListener('click', (e) => {
            if (didDrag) {
                e.preventDefault();
                e.stopPropagation();
            }
        }, true);
    }
    row?.addEventListener('scroll', updateInfoButtons);
</script>

<script>
    const careerRow = document.getElementById('careerRow');
    const careerDots = document.querySelectorAll('#careerDots .career-dot');
    const rightButton = document.querySelector('#careerDots .career-button.right');
    const leftButton = document.querySelector('#careerDots .career-button.left');
    const careerItems = careerRow ? Array.from(careerRow.children) : [];

    const scrollAmount = 300;
    const tolerance = 5; // px buffer to avoid rounding issues|

    updateCareerButtons();

    rightButton?.addEventListener("click", () => {
        careerRow?.scrollBy({
            left: scrollAmount,
            behavior: "smooth"
        });
    });

    leftButton?.addEventListener("click", () => {
        
        careerRow?.scrollBy({
            left: -scrollAmount,
            behavior: "smooth"
        });
    });

    function updateCareerButtons(){
         if (!careerRow || !leftButton || !rightButton) return;
        const { scrollLeft, scrollWidth, clientWidth } = careerRow;

        const atStart = scrollLeft <= tolerance;
        const atEnd = scrollLeft + clientWidth >= scrollWidth - tolerance;
        console.log("ScrollLeft: " + scrollLeft + ", tolerance: " + tolerance + ", atStart: " + atStart + ", atEnd: " + atEnd);
        leftButton.classList.toggle('is-hidden', atStart);
        rightButton.classList.toggle('is-hidden', atEnd);

    }

    careerDots.forEach((dot) => {
        dot.addEventListener('click', () => {
            const index = Number(dot.dataset.index);
            const target = careerItems[index];
            if (target && careerRow) {
                careerRow.scrollTo({ left: target.offsetLeft - careerRow.offsetLeft, behavior: 'smooth' });
            }
        });
    });

    if (careerRow) {
        // --- active dot tracking on scroll ---
        let ticking = false;
        const updateActiveDot = () => {
            const rowLeft = careerRow.getBoundingClientRect().left;
            let closestIndex = 0;
            let closestDist = Infinity;
            careerItems.forEach((item, i) => {
                const dist = Math.abs(item.getBoundingClientRect().left - rowLeft);
                if (dist < closestDist) {
                    closestDist = dist;
                    closestIndex = i;
                }
            });
            careerDots.forEach((dot, i) => dot.classList.toggle('active', i === closestIndex));
        };

        careerRow.addEventListener('scroll', () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
                updateActiveDot();
                ticking = false;
            });
        });

        // --- drag to scroll ---
        let isDown = false;
        let didDrag = false;
        let startX = 0;
        let startScrollLeft = 0;

        const startDrag = (clientX) => {
            isDown = true;
            didDrag = false;
            startX = clientX;
            startScrollLeft = careerRow.scrollLeft;
            careerRow.classList.add('dragging');
        };

        const moveDrag = (clientX) => {
            if (!isDown) return;
            const delta = clientX - startX;
            if (Math.abs(delta) > 3) didDrag = true;
            careerRow.scrollLeft = startScrollLeft - delta;
        };

        const endDrag = () => {
            if (!isDown) return;
            isDown = false;
            careerRow.classList.remove('dragging');
            updateActiveDot();
        };

        careerRow.addEventListener('pointerdown', (e) => {
            careerRow.setPointerCapture(e.pointerId);
            startDrag(e.clientX);
        });

        careerRow.addEventListener('pointermove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            moveDrag(e.clientX);
        });

        careerRow.addEventListener('pointerup', endDrag);
        careerRow.addEventListener('pointercancel', endDrag);
        careerRow.addEventListener('pointerleave', endDrag);

        // stop a drag from also firing a click on whatever's underneath
        careerRow.addEventListener('click', (e) => {
            if (didDrag) {
                e.preventDefault();
                e.stopPropagation();
            }
        }, true);
    }
    careerRow?.addEventListener('scroll', updateCareerButtons);
</script>

<script>
    const carousel = document.getElementById("technology-carousel");
    const leftButton = document.getElementById("tech-left");
    const rightButton = document.getElementById("tech-right");

    const scrollAmount = 300;
    const tolerance = 5; // px buffer to avoid rounding issues|

    function updateButtons(){
         if (!carousel || !leftButton || !rightButton) return;
        const { scrollLeft, scrollWidth, clientWidth } = carousel;

        const atStart = scrollLeft <= tolerance;
        console.log("ScrollLeft: " + scrollLeft + ", tolerance: " + tolerance + ", atStart: " + atStart);
        const atEnd = scrollLeft + clientWidth >= scrollWidth - tolerance;
        leftButton.classList.toggle('is-hidden', atStart);
        rightButton.classList.toggle('is-hidden', atEnd);

    }

    rightButton?.addEventListener("click", () => {
        carousel?.scrollBy({
            left: scrollAmount,
            behavior: "smooth"
        });
    });

    leftButton?.addEventListener("click", () => {
        
        carousel?.scrollBy({
            left: -scrollAmount,
            behavior: "smooth"
        });
    });

    carousel?.addEventListener('scroll', updateButtons);
    window.addEventListener('resize', updateButtons);

    updateButtons();
</script>

