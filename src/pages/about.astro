---
import Layout from '../layouts/Layout.astro';

import TempProfilePic from '../assets/TempProfilePic.png';

import { Mail, Calendar, MapPinHouse, ArrowRight, CodeXml, Lightbulb, Rocket, Gamepad2, ShoppingBag, Cpu } from "lucide-astro";
---

<Layout>
   <div style=" justify-content: space-between; background-color: #01040d; display: flex; gap: 40px; padding: 20px;">
        <div style="padding: 0px 40px;">
            <h1 style="color:purple; font-size: 25px; margin:0px;">About Me</h1>
            <h2 style="color: #fff; margin:0px; font-size:50px;">Hi, I'm Jordan</h2>
            <h2 style="color: purple; margin-top:10px;">Developer. Problem Solver. Builder</h2>
            <h3 style="color: #fff; margin-top:20px; font-size: 15px; max-width: 350px;">I'm a developer with a passion for building clean, and user focused solutions. I enjoy turning ideas into real products that make an impact.</h3>
            <div style="display:flex; gap:30px; margin-top:20px;">
                <div style="display:flex;">
                    <MapPinHouse style="color:purple; margin-right: 10px;" />
                    <div style="display:flex; flex-direction: column;">
                        <span style=" color: #fff; font-size: 14px;">Location </span>
                        <span style="color: #fff; font-size: 14px; margin-top:5px;">Pennsylvania, USA</span>
                    </div>
                </div>
                <div style="display:flex;">
                    <Calendar style="color:purple; margin-right: 10px;" />
                    <div style="display:flex; flex-direction: column;">
                        <span style="color: #fff; font-size: 14px;">Experience </span>
                        <span style="color: #fff; font-size: 14px; margin-top:5px;">3+ years</span>
                    </div>
                </div>
                <div style="display:flex;">
                    <Mail style="color:purple; margin-right: 10px;" />
                    <div style="display:flex; flex-direction: column;">
                        <span style="color: #fff; font-size: 14px;" >Email </span>
                        <span style="color: #fff; font-size: 14px; margin-top:5px;">j0rdnk1ng2000@gmail.com</span>
                    </div>
                </div>
            </div>
            <div style="padding:15px 0px; margin-top: 20px;">
                <a style="display:flex; width:fit-content; padding:20px; background-color: purple; color: white; text-decoration: none; border-radius: 5px;" href="mailto:j0rdnk1ng2000@gmail.com">Lets Connect <ArrowRight style="margin-left:10px;" color="white" size={18} /></a>
            </div>
        </div>

        <div>
            <img src={TempProfilePic.src} width="100%" height="350px" alt="Temp Profile Pic" />
        </div>
   </div>

   <div style="display: flex; background-color: #01040d; padding: 20px;">
        <div>
            <h1 style="margin:0px; font-size:14px; color: purple;">MY STORY</h1>
            <h2 style="margin-top:10px;  color: #fff;"> A little about me. </h2>
            <p style="margin-top:20px; font-size: 12px; color: #fff;"> I've always been curious about how things work. That curiosity led me to coding, where I found the perfect mix of creativity and logic. Over the years , I've worked on a variety of projects-- from web applications to embedded systems and game development.</p>
            <p style="margin:0px; font-size: 12px; color: #fff;"> When I'm not coding, you can find me exploring new technologies, hiking, or working on personal projects.</p>
            <div style="margin-top:20px;">
                <div style="display:flex;">
                    <div style="background-color: #0A101B; padding:10px; margin-right: 10px; border-radius: 6px;">
                        <CodeXml color="#8B5CF6" size={15} />
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 16px; color: #fff;">Focuse on writting clean, maintainable code.</span>
                        <span style=" font-size: 12px; color: #fff;">I follow best practices and enjoy solving complex problems.</span>
                    </div>
                </div>

                <div style="margin-top: 15px; display:flex;">
                    <div style="background-color: #0A101B; padding:10px; margin-right: 10px; border-radius: 6px;">
                        <Lightbulb color="#8B5CF6" size={15} />
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 16px; color: #fff;">Continous Learner.</span>
                        <span style=" font-size: 12px; color: #fff;">I'm always exploring new tools, frameworks, and technologies.</span>
                    </div>
                </div>

                <div style="margin-top: 15px; display:flex;">
                    <div style="background-color: #0A101B; padding:10px; margin-right: 10px; border-radius: 6px;">
                        <Rocket color="#8B5CF6" size={15} />
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 16px; color: #fff;">Builder at heart.</span>
                        <span style=" font-size: 12px; color: #fff;">I love taking ideas from concepts to a fully functional product.</span>
                    </div>
                </div>

            </div>
        </div>
        <div style="padding:20px; background-color: #0A101B; border-radius: 6px; display:flex; flex-direction: column;">
            <h2 style="margin-bottom: 20px; margin-top: 0px; color: #fff;"> What I Do </h2>
            <div>
                <div style="display:flex;">
                    <div style="padding:10px 20px; border-radius: 6px; background-color: #01040d; margin-right: 10px;">
                        <CodeXml color="#8B5CF6" size={40} />
                    </div>
                    <div style="display:flex; flex-direction: column;">
                        <span style="font-size: 16px; color: #fff;">Web Development</span>
                        <span style="font-size: 14px; color: #ccc;">Building responsive, accessible, and performant web applications with modern technologies.</span>
                    </div>    
                </div>

                <div style="display:flex; margin-top: 15px;">
                     <div style="padding:10px 20px; border-radius: 6px; background-color: #01040d; margin-right: 10px;">
                        <ShoppingBag color="#8B5CF6" size={40} />
                     </div>
                    
                    <div style="display:flex; flex-direction: column;">
                        <span style="font-size: 16px; color: #fff;">E-Commerce Solutions</span>
                        <span style="font-size: 14px; color: #ccc;">Creating custom e-commerce experinces that drive results and improve conversions.</span>
                    </div>    
                </div>

                <div style="display:flex; margin-top: 15px;">
                     <div style="padding:10px 20px; border-radius: 6px; background-color: #01040d; margin-right: 10px;">
                        <Gamepad2 color="#8B5CF6" size={40} />
                    </div>
                    
                    
                    <div style="display:flex; flex-direction: column;">
                        <span style="font-size: 16px; color: #fff;">Game Development</span>
                        <span style="font-size: 14px; color: #ccc;">Designing and developing immersive gameplay experince in Unreal Engine.</span>
                    </div>    
                </div>

                <div style="display:flex; margin-top: 15px;">
                    <div style="padding:10px 20px; border-radius: 6px; background-color: #01040d; margin-right: 10px;">
                        <Cpu color="#8B5CF6" size={40} />
                    </div>
                    
                    
                    <div style="display:flex; flex-direction: column;">
                        <span style="font-size: 16px; color: #fff;">Embedded Systems</span>
                        <span style="font-size: 14px; color: #ccc;">Working with microcontrollers and sensors to build reliable, efficient embedded solutions.</span>
                    </div>    
                </div>
            </div>
        </div>

        <div>
            <span>TECHNOLOGIES I WORK WITH</span>
            <div>
            
            </div>   
        </div>
   </div>
   
   
   <div></div>
   <div></div>
</Layout>