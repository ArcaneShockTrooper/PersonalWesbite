---
import Layout from '../layouts/Layout.astro';

import TempProfilePic from '../assets/TempProfilePic.png';

import { Mail, Calendar, MapPinHouse } from "lucide-astro";
---

<Layout>
   <div style="display: flex; gap: 40px; padding: 20px;">
        <div style="padding: 0px 40px;">
            <h1>About Me</h1>
            <h2>Hi, I'm Jordan</h2>
            <h3>I'm a developer with a passion for building clean, and user focused solutions. I enjoy turning ideas into real products that make an impact.</h3>
            <div style="display:flex; gap:20px; margin-top:20px;">
                <div style="display:flex;">
                    <MapPinHouse style="margin-right: 10px;" />
                    <span> Location <br> Pennsylvania, USA</span>
                </div>
                <div style="display:flex;">
                    <Calendar style="margin-right: 10px;" />
                    <span> Experience <br>  3+ years</span>
                </div>
                <div style="display:flex;">
                    <Mail style="margin-right: 10px;" />
                    <span> Email <br> j0rdnk1ng2000@gmail.com</span>
                </div>
            </div>
            <div>
                <a>Lets Connect</a>
            </div>
        </div>

        <div>
            <img src={TempProfilePic.src} width="100%" height="100%" alt="Temp Profile Pic" />
        </div>
   </div>

   <div></div>
   <div></div>
   <div></div>
</Layout>