---
import Layout from '../layouts/Layout.astro';

import HanksBeltsPic from '../assets/HanksBelts_SS.png';
import codingNoBackground from '../assets/codingNoBackground.png';

import { CodeXml, ShoppingBag, Gamepad2, Cpu, SquareArrowOutUpRight } from "lucide-astro";
---




<Layout>
    <main>
        <div style="display:flex; justify-content: space-between; padding:40px; background:#01040d;">
            <div style="width: 50%;">
                <h2 style="margin: 0; color:white;">My Work</h2>
                <h1 style="margin-top:5px; font-size:50px; margin: 0; color:white;">Projects</h1>
                <p style="margin-top:10px; max-width:400px;  color:white;"> A collection of projects I've built or contributed to. From web applications to game development and embedded systems.</p>
            </div>

            <div style="display:flex;">
                <div>
                    <img src={codingNoBackground.src} width="200" height="200" alt="Coding Image" />
                </div>
                <div style="margin-left:20px; align-self: center; align-items: center; display:flex; flex-direction: column;">
                    <div>
                        <ShoppingBag color="#10B981" size={48} />
                    </div>
                    
                    <div style="display:flex; width:200px; justify-content:space-between;">
                        <Gamepad2 color="#3B82F6" size={48} />
                        <CodeXml color="#8B5CF6" size={48} />
                    </div>
                    
                    <div>
                        <Cpu color="#F97316" size={48} />
                    </div>
                    
                </div>
            </div>

        </div>
    </main>
    <div style="padding:0px 40px; background:#01040d;">
        <div style="padding:20px 0px; border-top:1px solid grey;">
            <button style="background:purple; padding:15px; border:none; border-radius:6px; color:white;">All Projects</button>
            <button style="padding:20px; border:none; background:none; color:white;">Web Development</button>
            <button style="padding:20px; border:none; background:none; color:white;">E-Commerce</button>
            <button style="padding:20px; border:none; background:none; color:white;">Game Development</button>   
            <button style="padding:20px; border:none; background:none; color:white;">Embedded Systems</button>
        </div>

        <div style="display:flex; justify-content:center; gap:20px; padding:20px 0px;">

            <div style="border-radius: 12px; max-width:500px; background:#0A101B; width:50%; display:flex; flex-direction:column;">

                <div style=" padding:10px; display:flex;">
                    <div style="border-radius: 12px; width:100%;">
                        <img style="border-radius: 12px; height:100%; width:100%;" src={HanksBeltsPic.src} width="100" height="100" alt="Hank's Belts" />
                    </div>
                    <div style="width:70%; padding:0px 20px;">
                        <span style="font-size: 12px; padding: 5px; border-radius: 6px; background: purple; color: white; margin-bottom: 10px;">E-COMMERCE</span>
                        <h2 style="color:white; margin:15px 0px 0px;">Hank's Belts</h2>
                        <p style="color:white; margin-top:10px;">Custom Shopify storefront with advanced discount logic and seamless UX.</p>
                        <p style="color:white; margin-top:40px; font-size: 12px;">Shopify &#8226; Liquid &#8226; JavaScript</p>
                    </div>
                </div>

                <div style="border-top:1px solid grey;;">
                    <a style="text-decoration: none; color:white; padding:10px; display:flex; align-items:center; gap:10px;" href="https://hanksbelts.com" target="_blank" rel="noopener noreferrer">
                        <span>Live Site</span>
                        <SquareArrowOutUpRight color="white" size={18} />
                    </a>
                </div>
            </div>

            <div style="border-radius: 12px; max-width:500px; background:#0A101B; width:50%; display:flex; flex-direction:column;">

                <div style=" padding:10px; display:flex;">
                    <div style="border-radius: 12px; width:100%;">
                        <img style="border-radius: 12px; height:100%; width:100%;" src={HanksBeltsPic.src} width="100" height="100" alt="Hank's Belts" />
                    </div>
                    <div style="width:70%; padding:0px 20px;">
                        <span style="font-size: 12px; padding: 5px; border-radius: 6px; background: purple; color: white; margin-bottom: 10px;">E-COMMERCE</span>
                        <h2 style="color:white; margin:15px 0px 0px;">Hank's Belts</h2>
                        <p style="color:white; margin-top:10px;">Custom Shopify storefront with advanced discount logic and seamless UX.</p>
                        <p style="color:white; margin-top:40px; font-size: 12px;">Shopify &#8226; Liquid &#8226; JavaScript</p>
                    </div>
                </div>

                <div style="border-top:1px solid grey;;">
                    <a style="text-decoration: none; color:white; padding:10px; display:flex; align-items:center; gap:10px;" href="https://hanksbelts.com" target="_blank" rel="noopener noreferrer">
                        <span>Live Site</span>
                        <SquareArrowOutUpRight color="white" size={18} />
                    </a>
                </div>
            </div>

        </div>
    </div>
</Layout>