<style>
    .project-row {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .project-card {
        text-decoration: unset;
        background: #0A101B;
        border-radius: 6px;
        border: 2px solid white;
        width: 33%;
        display: block;
        -webkit-user-drag: none;
        user-drag: none;
    }

    .project-dots {
        display: none;
        justify-content: center;
        gap: 8px;
        margin-top: 14px;
    }

    .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        border: none;
        padding: 0;
        background: rgba(255, 255, 255, 0.25);
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
    }

    .dot.active {
        background: #8B5CF6;
        transform: scale(1.3);
    }

	.project-card img {
        -webkit-user-drag: none;
        user-drag: none;
        pointer-events: none; /* let pointer events pass through to the row for dragging */
    }
    @media (min-width: 960px) {
        .projectCarousel-container{
            padding:40px;
        }
    }

    @media (max-width: 960px) {
        .projectCarousel-container{
            padding-bottom: 20px;
        }
        .projectCarousel-titleContent{
            padding:0 40px 0 40px;
            align-items: center;
        }
        .projectCarousel-titleButtons{
            flex-flow: column;
        }
        .project-row {
            overflow-x: auto;
            /* scroll-snap-type: x mandatory; */
            /* -webkit-overflow-scrolling: touch; */
            gap: 16px;
            scrollbar-width: none;
            cursor: grab;
            user-select: none;
        }

        .project-row::-webkit-scrollbar {
            display: none;
        }

        .project-row.dragging {
            cursor: grabbing;
            scroll-snap-type: none;
        }

        .project-card {
            flex-shrink: 0;
            width: 85%;
            /*scroll-snap-align: start;
            scroll-snap-stop: always;*/
        }

        .project-dots {
            display: flex;
        }
    }
</style>

<script>
    const row = document.getElementById('projectRow');
    const dots = document.querySelectorAll('#projectDots .dot');
    const items = row ? Array.from(row.children) : [];

    const updateActiveDot = (index) => {
        dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
    };

    const getClosestIndex = () => {
        const rowLeft = row.getBoundingClientRect().left;
        let closestIndex = 0;
        let closestDist = Infinity;
        items.forEach((item, i) => {
            const dist = Math.abs(item.getBoundingClientRect().left - rowLeft);
            if (dist < closestDist) {
                closestDist = dist;
                closestIndex = i;
            }
        });
        return closestIndex;
    };

    // eased animation to a target scrollLeft, so snapping feels smooth instead of instant
    const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

    let animationFrame;
    const animateScrollTo = (target, duration = 350) => {
        cancelAnimationFrame(animationFrame);
        const start = row.scrollLeft;
        const change = target - start;
        const startTime = performance.now();

        const step = (now) => {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            row.scrollLeft = start + change * easeOutCubic(progress);
            if (progress < 1) {
                animationFrame = requestAnimationFrame(step);
            }
        };
        animationFrame = requestAnimationFrame(step);
    };

    const goToIndex = (index) => {
        const clamped = Math.max(0, Math.min(index, items.length - 1));
        const target = items[clamped].offsetLeft - row.offsetLeft;
        animateScrollTo(target);
        updateActiveDot(clamped);
    };

    dots.forEach((dot) => {
        dot.addEventListener('click', () => goToIndex(Number(dot.dataset.index)));
    });

    if (row) {
        // --- drag to scroll, with velocity tracking for momentum ---
        let isDown = false;
        let didDrag = false;
        let startX = 0;
        let startScrollLeft = 0;
        let lastX = 0;
        let lastTime = 0;
        let velocity = 0;

        const startDrag = (clientX) => {
            cancelAnimationFrame(animationFrame);
            isDown = true;
            didDrag = false;
            startX = clientX;
            startScrollLeft = row.scrollLeft;
            lastX = clientX;
            lastTime = performance.now();
            velocity = 0;
            row.classList.add('dragging');
        };

        const moveDrag = (clientX) => {
            if (!isDown) return;
            const delta = clientX - startX;
            if (Math.abs(delta) > 3) didDrag = true;
            row.scrollLeft = startScrollLeft - delta;

            const now = performance.now();
            const dt = now - lastTime;
            if (dt > 0) {
                velocity = (clientX - lastX) / dt; // px per ms
            }
            lastX = clientX;
            lastTime = now;
        };

        const endDrag = () => {
            if (!isDown) return;
            isDown = false;
            row.classList.remove('dragging');

            const currentIndex = getClosestIndex();
            const flickThreshold = 0.35; // px/ms, tune to taste

            let targetIndex = currentIndex;
            if (velocity < -flickThreshold) {
                targetIndex = currentIndex + 1; // flicked left fast -> advance
            } else if (velocity > flickThreshold) {
                targetIndex = currentIndex - 1; // flicked right fast -> go back
            }

            goToIndex(targetIndex);
        };

        row.addEventListener('pointerdown', (e) => {
            e.preventDefault();
            row.setPointerCapture(e.pointerId);
            startDrag(e.clientX);
        });

        row.addEventListener('pointermove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            moveDrag(e.clientX);
        });

        row.addEventListener('pointerup', endDrag);
        row.addEventListener('pointercancel', endDrag);
        row.addEventListener('pointerleave', endDrag);
        row.addEventListener('dragstart', (e) => e.preventDefault());

        row.addEventListener('click', (e) => {
            if (didDrag) {
                e.preventDefault();
                e.stopPropagation();
            }
        }, true);
    }
</script>

<style>
    .skills-outer {
        background: #0A101B;
        color: white;
        padding: 20px 0px;
    }

    @media (min-width: 970px){
        .skills-outer {
            border: 2px solid grey;
            border-radius: 6px;
        }
    }

    @media (max-width: 970px){
        .skills-outer {
            border-top: 2px solid grey;
            border-bottom: 2px solid grey;
            border-radius: 0px;
        }
    }

	.skills-spacer {
		flex-shrink: 0;
		width: 1px; /* just enough to stop hard clipping at the last card's edge */
	}

    .skills-row {
        display: flex;
    }

    .skill-card {
        background: #0A101B;
        text-align: center;
        border-right: 2px solid white;
        padding: 0px 20px;
        flex: 1;
		min-width:175px;
		-webkit-user-drag: none;
		user-drag: none;
    }

	.skill-card svg {
		pointer-events: none; /* let pointer events pass through to the row */
		-webkit-user-drag: none;
		user-drag: none;
	}

	.skill-card h2,
	.skill-card p {
		pointer-events: none; /* text shouldn't intercept the drag gesture either */
	}

    .skill-card:last-child {
        border-right: none;
    }

    .skills-dots {
        display: none;
        justify-content: center;
        gap: 8px;
        margin-top: 14px;
    }

    .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        border: none;
        padding: 0;
        background: rgba(255, 255, 255, 0.25);
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
    }

    .dot.active {
        background: #8B5CF6;
        transform: scale(1.3);
    }

	.skillCarosuel-Container {
		background:#01040d;
	}

	@media (min-width: 969px) {
		.skillCarosuel-Container {
			padding:40px;
		}
	}

    @media (max-width: 970px) {
		.skillCarosuel-Container {
			padding-bottom: 20px;
		}
        .skills-spacer {
			width: 16px; /* matches the leading padding for visual symmetry */
		}
		.skills-row {
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			gap: 16px;
			padding: 4px 16px 4px 16px; /* small top/bottom padding added too */
			scrollbar-width: none;
			cursor: grab;
			user-select: none;
		}

        .skills-row::-webkit-scrollbar {
            display: none;
        }

        .skills-row.dragging {
            cursor: grabbing;
        }

        .skill-card {
            flex-shrink: 0;
            width: 85%;
            border-right: none; /* divider look breaks once cards peek/scroll individually */
            border: 2px solid white !important;
            border-radius: 6px;
            padding: 20px;
        }

        .skills-dots {
            display: flex;
        }
    }
</style>
<script>
(function () {
    const skillsRow = document.getElementById('skillsRow');
    const skillsDots = document.querySelectorAll('#skillsDots .dot');
    const skillsItems = skillsRow ? Array.from(skillsRow.children) : [];

    const updateSkillsActiveDot = (index) => {
        skillsDots.forEach((dot, i) => dot.classList.toggle('active', i === index));
    };

    const getSkillsClosestIndex = () => {
        const rowLeft = skillsRow.getBoundingClientRect().left;
        let closestIndex = 0;
        let closestDist = Infinity;
        skillsItems.forEach((item, i) => {
            const dist = Math.abs(item.getBoundingClientRect().left - rowLeft);
            if (dist < closestDist) {
                closestDist = dist;
                closestIndex = i;
            }
        });
        return closestIndex;
    };

    const skillsEaseOutCubic = (t) => 1 - Math.pow(1 - t, 3);

    let skillsAnimationFrame;
    const animateSkillsScrollTo = (target, duration = 350) => {
        cancelAnimationFrame(skillsAnimationFrame);
        const start = skillsRow.scrollLeft;
        const change = target - start;
        const startTime = performance.now();

        const step = (now) => {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            skillsRow.scrollLeft = start + change * skillsEaseOutCubic(progress);
            if (progress < 1) {
                skillsAnimationFrame = requestAnimationFrame(step);
            }
        };
        skillsAnimationFrame = requestAnimationFrame(step);
    };

    const goToSkillsIndex = (index) => {
        const clamped = Math.max(0, Math.min(index, skillsItems.length - 1));
        const target = skillsItems[clamped].offsetLeft - (skillsRow.offsetLeft * 2);
		console.log("skill Item offset:", skillsItems[clamped].offsetLeft, "skill row offset:", skillsRow.offsetLeft, "Target scrollLeft:", target);
        animateSkillsScrollTo(target);
        updateSkillsActiveDot(clamped);
    };

    skillsDots.forEach((dot) => {
        dot.addEventListener('click', () => goToSkillsIndex(Number(dot.dataset.index)));
    });

    if (skillsRow) {
        let skillsIsDown = false;
        let skillsDidDrag = false;
        let skillsStartX = 0;
        let skillsStartScrollLeft = 0;
        let skillsLastX = 0;
        let skillsLastTime = 0;
        let skillsVelocity = 0;

        const startSkillsDrag = (clientX) => {
            cancelAnimationFrame(skillsAnimationFrame);
            skillsIsDown = true;
            skillsDidDrag = false;
            skillsStartX = clientX;
            skillsStartScrollLeft = skillsRow.scrollLeft;
            skillsLastX = clientX;
            skillsLastTime = performance.now();
            skillsVelocity = 0;
            skillsRow.classList.add('dragging');
        };

        const moveSkillsDrag = (clientX) => {
			console.log("Moving skills drag");
            if (!skillsIsDown) return;
            const delta = clientX - skillsStartX;
            if (Math.abs(delta) > 3) skillsDidDrag = true;
            skillsRow.scrollLeft = skillsStartScrollLeft - delta;

            const now = performance.now();
            const dt = now - skillsLastTime;
            if (dt > 0) {
                skillsVelocity = (clientX - skillsLastX) / dt;
            }
            skillsLastX = clientX;
            skillsLastTime = now;
        };

        const endSkillsDrag = () => {
            if (!skillsIsDown) return;
            skillsIsDown = false;
            skillsRow.classList.remove('dragging');

            const currentIndex = getSkillsClosestIndex();
            const flickThreshold = 0.35;

            let targetIndex = currentIndex;
            if (skillsVelocity < -flickThreshold) {
                targetIndex = currentIndex + 1;
            } else if (skillsVelocity > flickThreshold) {
                targetIndex = currentIndex - 1;
            }

            goToSkillsIndex(targetIndex);
        };

        skillsRow.addEventListener('pointerdown', (e) => {
            e.preventDefault();
            skillsRow.setPointerCapture(e.pointerId);
            startSkillsDrag(e.clientX);
        });

        skillsRow.addEventListener('pointermove', (e) => {
            if (!skillsIsDown) return;
            e.preventDefault();
            moveSkillsDrag(e.clientX);
        });

        skillsRow.addEventListener('pointerup', endSkillsDrag);
        skillsRow.addEventListener('pointercancel', endSkillsDrag);
        skillsRow.addEventListener('pointerleave', endSkillsDrag);
        skillsRow.addEventListener('dragstart', (e) => e.preventDefault());

        skillsRow.addEventListener('click', (e) => {
            if (skillsDidDrag) {
                e.preventDefault();
                e.stopPropagation();
            }
        }, true);
    }
})();
</script>