---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import profilePicture from '../assets/TempProfilePic.png';
import linkedInIcon from '../assets/linkedin.png';
import githubIcon from '../assets/github.png';
import tempDelveImage from '../assets/TempPicture.png';
import emailIcon from '../assets/mail.png';
import HanksBeltsPic from '../assets/HanksBelts_SS.png';
import WoolxPic from '../assets/Woolx_SS.png';

import { CodeXml, ShoppingBag, Gamepad2, Cpu, ArrowRight, User, Mail } from "lucide-astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---



<Layout>
	<div style="padding:0px 40px; height:100vh; justify-content:center; background:#01040d; align-items:start; display:flex; flex-direction:column;">
		
		<h2 style="color:purple; margin:0px;">Hi, I'm</h2>
		<h1 style="color:white; margin:0px; margin-top:5px; font-size:50px;">Jordan King</h1>
		<h2 style="color:purple; margin:0px;">Developer. Problem Solver. Builder</h2>
		<p style="color:white; max-width:400px;">Front-End Web Developer with experince building and maintaining e-commerce experinces. Passionate about clean code, performance, and creating things that matter</p>
		
		<div style="display:flex; gap:20px; justify-content:center;">	
			<a href="http://localhost:4321/projects" style="text-decoration: none; display:flex; align-items: center; background:purple; color:white; padding:10px; border-radius:6px; text-decoration:none;`">View My Work<ArrowRight style="margin-left:10px;" color="white" size={20} /></a>
			<a style="display:flex; align-items: center; border:2px solid white; background:#01040d; color:white; padding:10px; border-radius:6px; text-decoration:none;`">About Me<User style="margin-left:10px;" color="white" size={20} /></a>
		</div>

		<div style="padding:20px 0px; display:flex; gap:20px; justify-content:center;">
			<a href="https://github.com/ArcaneShockTrooper">
				<img src={githubIcon.src} width="30" height="30" alt="GitHub" />
			</a>
			<a href="https://www.linkedin.com/in/jordan-king-b745751a3/" >
				<img src={linkedInIcon.src} width="30" height="30" alt="LinkedIn" />
			</a>
			<a href="mailto:j0rdnk1ng2000@gmail.com">
				<Mail style="margin-left:10px;" color="white" size={30} />
			</a>
		</div>

		<div style="border:2px solid grey; display:flex; background:#0A101B; color:white; border-radius:6px; padding:20px 0px;">
			
			<div style="background:#0A101B; text-align:center; border-right: 2px solid white; padding:0px 20px;">
				<CodeXml color="#8B5CF6" size={48} />
				<h2 style="font-size: 20px;">Web Development</h2>
				<p>Building fast, responsive, and accessible websites with modern technologies</p>
			</div>

			<div style="background:#0A101B; text-align:center; border-right: 2px solid white; padding:0px 20px;">
				<ShoppingBag color="#10B981" size={48} />
				<h2 style="font-size: 20px;">E-Commerce</h2>
				<p>Experience with Shopify, custom apps, and complex storefront development</p>
			</div>

			<div style="background:#0A101B; text-align:center; border-right: 2px solid white; padding:0px 20px;">
				<Gamepad2 color="#3B82F6" size={48} />
				<h2 style="font-size: 20px;">Game Development</h2>
				<p>Exploring Unreal Engine to bring interactive ideas and worlds to life</p>
			</div>
			
			<div style="background:#0A101B; text-align:center; padding:0px 20px;">
				<Cpu color="#F97316" size={48} />
				<h2 style="font-size: 20px;"> Embedded Systems</h2>
				<p>Learning C and embedded programming to build smart, efficient devices</p>
			</div>
	
		</div>

	</div>


	<div style=" background:#01040d; padding:20px;">
		<div style="display:flex; flex-direction:column;">
			<h2 style="color:purple; font-size: 20px; margin:0px;">Featured Projects</h2>
			<div style="display:flex; align-items:center; justify-content:space-between;">
				<h3 style=" color:purple; font-size:30px; margin:0px;">Things I've Built</h3>
				<a href="http://localhost:4321/projects" style="text-decoration: none; color:rgb(91, 91, 234); display:flex;">View all projects<ArrowRight style="margin-left:10px;" color="rgb(91, 91, 234)" size={20} /></a>
			</div>
			
		</div>
		<div style="display:flex; gap:10px; margin-top:20px;">
			
			<div  style="background:#0A101B; border-radius: 6px; border:2px solid white; width:33%;">
				<div style="height:50%;">
					<img style="height:100%; width:100%;" src={HanksBeltsPic.src} width="100" height="100" alt="Hank's Belts" />
				</div>
				<div style="padding:10px;">
					<span style="font-size: 12px; padding: 5px; border-radius: 6px; background: purple; color: white; margin-bottom: 10px;">E-COMMERCE</span>
					<h2 style="color:white; margin:15px 0px 0px;">Hank's Belts</h2>
					<p style="color:white; margin:10px 0px 20px 0px; font-size: 14px;">Custom Shopify storefront with advanced discount logic and seamless UX.</p>
					<p style="color:white; margin:0px; font-size: 12px;">Shopify &#8226; Liquid &#8226; JavaScript</p>
				</div>
			</div>

			<div  style="background:#0A101B; border-radius: 6px; border:2px solid white; width:33%;">
				<div style="height:50%;">
					<img style="height:100%; width:100%;" src={WoolxPic.src} width="100" height="100" alt="Woolx" />
				</div>
				<div style="padding:10px;">
					<span style="font-size: 12px; padding: 5px; border-radius: 6px; background: purple; color: white; margin-bottom: 10px;">E-COMMERCE</span>
					<h2 style="color:white; margin:15px 0px 0px;">Woolx</h2>
					<p style="color:white; margin:10px 0px 20px 0px; font-size: 14px;">Custom Shopify storefront with advanced discount logic and seamless UX.</p>
					<p style="color:white; margin:0px; font-size: 12px;">Shopify &#8226; Liquid &#8226; JavaScript</p>
				</div>
			</div>

			<div  style="background:#0A101B; border-radius: 6px; border:2px solid white; width:33%;">
				<div style="height:50%;">
					<img style="height:100%; width:100%;" src={tempDelveImage.src} width="100" height="100" alt="Delve" />
				</div>
				<div style="padding:10px;">
					<span style="font-size: 12px; padding: 5px; border-radius: 6px; background: blue; color: white; margin-bottom: 10px;">Game Dev</span>
					<h2 style="color:white; margin:15px 0px 0px;">Delve</h2>
					<p style="color:white; margin:10px 0px 20px 0px; font-size: 14px;">Custom Shopify storefront with advanced discount logic and seamless UX.</p>
					<p style="color:white; margin:0px; font-size: 12px;">Unreal Engine 5 &#8226; Blueprints &#8226; C++</p>
				</div>
			</div>

		</div>
	</div>
	
</Layout>
